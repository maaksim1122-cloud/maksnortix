435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438\u043c \u043f\u0443\u043b\u044c\u0442\u043e\u043c \u0442\u0435\u043b\u0435\u0432\u0456\u0437\u043e\u0440\u0430 (\u0441\u0442\u0440\u0456\u043b\u043a\u0438 \u043d\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0457 \u0412\u0433\u043e\u0440\u0443/\u0412\u043d\u0438\u0437/\u0412\u043b\u0456\u0432\u043e/\u0412\u043f\u0440\u0430\u0432\u043e, \u043a\u043d\u043e\u043f\u043a\u0430 OK \u0442\u0430 \u041d\u0430\u0437\u0430\u0434) \u0437 \u043f\u0456\u0434\u0441\u0432\u0456\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043e\u0431\u0440\u0430\u043d\u043e\u0433\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430.\n* \u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0434\u043e \u0456\u0441\u043d\u0443\u044e\u0447\u043e\u0433\u043e \u0430\u043a\u0430\u0443\u043d\u0442\u0430 \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456 \u044f\u043a \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e (\u0431\u0435\u0437 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f \u0441\u0435\u0441\u0456\u0457 \u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456 \u0442\u0430 \u0431\u0435\u0437 \u043f\u043e\u0442\u0440\u0435\u0431\u0438 \u0443 Google \u0414\u0438\u0441\u043a\u0443).\n* \u0413\u043e\u0440\u0438\u0437\u043e\u043d\u0442\u0430\u043b\u044c\u043d\u0430 \u043e\u0440\u0456\u0454\u043d\u0442\u0430\u0446\u0456\u044f (16:9) \u0434\u043b\u044f \u0432\u0441\u0456\u0445 \u0435\u043a\u0440\u0430\u043d\u0456\u0432, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 \u0430\u0443\u0434\u0456\u043e- \u0442\u0430 \u0432\u0456\u0434\u0435\u043e\u0434\u0437\u0432\u0456\u043d\u043a\u0438.\n* \u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u0442\u0435\u043b\u0435\u0432\u0456\u0437\u043e\u0440 \u0